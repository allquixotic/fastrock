import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, FlatButton } from "theme.slint";
export struct ProfileRow { id: string, name: string, detail: string }
export global ProfileState {
    in property <[ProfileRow]> rows;
    in property <bool> busy;
    in property <string> status;
    in-out property <string> edit-id;
    in property <bool> edit-foundry;
    in-out property <string> revision;
    in property <string> create-id;
    in-out property <string> name;
    in-out property <int> engine;
    in-out property <string> url;
    in-out property <string> model;
    in-out property <string> base-path;
    in-out property <string> secret;
    in-out property <string> azure-subscription;
    callback load();
    callback select(id: string);
    callback save();
    callback engine-selected();
}
export component ProviderProfiles inherits VerticalLayout {
    spacing: Theme.pad-m;
    HorizontalLayout {
        Text { text: "Named provider profiles"; color: Theme.text; font-size: Theme.font-size-large; font-weight: 600; horizontal-stretch: 1; }
        FlatButton { text: "New profile"; enabled: !ProfileState.busy; clicked => { ProfileState.select(""); } }
        FlatButton { text: "Reload profiles"; enabled: !ProfileState.busy; clicked => { ProfileState.load(); } }
    }
    for row in ProfileState.rows: Rectangle {
        background: row.id == ProfileState.edit-id ? Theme.selected : Theme.surface-sunken;
        border-radius: Theme.radius-small;
        HorizontalLayout {
            padding: Theme.pad-m;
            VerticalLayout {
                Text { text: row.name; color: Theme.text; font-weight: 600; }
                Text { text: row.detail; color: Theme.text-muted; wrap: word-wrap; }
            }
            FlatButton { text: "Edit profile"; enabled: !ProfileState.busy; clicked => { ProfileState.select(row.id); } }
        }
    }
    LineEdit { text <=> ProfileState.name; placeholder-text: "Profile name"; enabled: !ProfileState.busy; }
    if ProfileState.edit-id == "": ComboBox {
        model: ["OpenAI", "Anthropic", "Microsoft Foundry (Azure CLI SSO)"];
        current-index <=> ProfileState.engine;
        enabled: !ProfileState.busy;
        selected(value) => { ProfileState.engine-selected(); }
    }
    if ProfileState.edit-id != "" && !ProfileState.edit-foundry: ComboBox {
        model: ["OpenAI", "Anthropic"];
        current-index <=> ProfileState.engine;
        enabled: !ProfileState.busy;
        selected(value) => { ProfileState.engine-selected(); }
    }
    if ProfileState.engine == 2: Text {
        text: "Microsoft Foundry uses Azure CLI SSO. Deploy MAI Code 2 Flash in your project, then sign in with az login on this computer.";
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    LineEdit { text <=> ProfileState.url; placeholder-text: ProfileState.engine == 2 ? "Foundry project endpoint" : "API base URL (e.g. https://api.openai.com/v1)"; enabled: !ProfileState.busy; }
    if ProfileState.engine == 0: LineEdit { text <=> ProfileState.base-path; placeholder-text: "API request path (optional, e.g. openai/v1/responses)"; enabled: !ProfileState.busy; }
    LineEdit { text <=> ProfileState.model; placeholder-text: ProfileState.engine == 2 ? "Foundry deployment name" : "Model ID"; enabled: !ProfileState.busy; }
    if ProfileState.engine == 2: LineEdit { text <=> ProfileState.azure-subscription; placeholder-text: "Azure subscription ID"; enabled: !ProfileState.busy; }
    if ProfileState.engine != 2: LineEdit { text <=> ProfileState.secret; input-type: password; placeholder-text: ProfileState.edit-id == "" ? "API key" : "New API key (leave empty to keep existing)"; enabled: !ProfileState.busy; }
    if ProfileState.engine != 2: Text { text: "Keys are saved only in the OS credential vault. Reopen or reselect the provider to use changed connection settings."; color: Theme.text-faint; wrap: word-wrap; }
    if ProfileState.engine == 0: Text { text: "Bedrock Ultrafast requires a supported model, region and the Responses API path openai/v1/responses."; color: Theme.text-faint; wrap: word-wrap; }
    FlatButton { text: ProfileState.edit-id == "" ? "Create profile" : "Save profile"; enabled: !ProfileState.busy; clicked => { ProfileState.save(); } }
    if ProfileState.status != "": Text { text: ProfileState.status; color: Theme.text-muted; wrap: word-wrap; }
}
