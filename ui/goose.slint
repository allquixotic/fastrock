import { ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, FlatButton } from "theme.slint";

export struct GooseOption {
    id: string,
    title: string,
    names: [string],
    values: [string],
    selected: int,
}
export global GooseState {
    in property <bool> active;
    in property <bool> busy;
    in property <bool> changing;
    in property <[GooseOption]> options;
    in property <string> summary: "Goose";
    in property <string> error;
    callback choose(id: string, value: string);
    in-out property <string> cheap-name: "Bedrock Luna";
    in-out property <string> cheap-model: "openai.gpt-6-luna";
    in-out property <int> cheap-provider;
    in property <bool> cheap-loading;
    in property <string> cheap-status;
    callback save-cheap();
    in property <bool> recovery-paused;
    in property <int> recovered-pending;
    in property <int> uncertain-count;
    in property <string> recovery-details;
    callback resume-recovered();
    callback copy-recovery();
    callback dismiss-recovery();
}
export component GooseControls inherits Rectangle {
    property <bool> expanded;
    property <bool> review-open;
    VerticalLayout {
        spacing: Theme.pad-s;
        if GooseState.recovery-paused: HorizontalLayout {
            Text { text: "Recovered work is paused · " + GooseState.recovered-pending + " queued"; color: Theme.text-muted; wrap: word-wrap; vertical-alignment: center; }
            FlatButton { text: "Resume"; enabled: !GooseState.changing && !GooseState.busy; clicked => { GooseState.resume-recovered(); } }
        }
        if GooseState.uncertain-count > 0: VerticalLayout {
            FlatButton { text: "Review interrupted sends (" + GooseState.uncertain-count + ")"; clicked => { root.review-open = !root.review-open; } }
            if root.review-open: VerticalLayout {
                Text { text: "These sends may have reached the model or run tools. They will not be sent again automatically. Check the conversation and tool results before continuing."; color: Theme.text-muted; wrap: word-wrap; }
                TextEdit { text: GooseState.recovery-details; read-only: true; height: 130px; wrap: word-wrap; }
                HorizontalLayout {
                    FlatButton { text: "Copy recovery records"; clicked => { GooseState.copy-recovery(); } }
                    FlatButton { text: "Dismiss reviewed records"; enabled: !GooseState.changing; clicked => { GooseState.dismiss-recovery(); } }
                }
            }
        }
        FlatButton {
            text: GooseState.summary + (root.expanded ? "  ▴" : "  ▾");
            clicked => { root.expanded = !root.expanded; }
        }
        if root.expanded: ScrollView {
            height: min(180px, GooseState.options.length * 38px + 36px);
            VerticalLayout {
                spacing: Theme.pad-s;
                for option in GooseState.options: HorizontalLayout {
                    Text { text: option.title; color: Theme.text-muted; width: 110px; vertical-alignment: center; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: option.names;
                        current-index: option.selected;
                        enabled: !GooseState.busy && !GooseState.changing && option.values.length > 1;
                        selected(value) => { GooseState.choose(option.id, option.values[self.current-index]); }
                    }
                }
                Text { text: "Goose controls tool permissions; ACP does not provide an OS sandbox."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-size-small; }
            }
        }
        if GooseState.error != "": Text { text: GooseState.error; color: Theme.danger; wrap: word-wrap; }
    }
}

export component GooseSettingsPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: Theme.pad-xl;
            spacing: Theme.pad-l;
            alignment: start;
            Text { text: "Goose"; color: Theme.text; font-size: Theme.font-size-large; font-weight: 600; }
            Text { text: "Goose runs inside Fastrock. Your existing Goose provider settings, credentials, extensions and conversations remain in place."; color: Theme.text; wrap: word-wrap; }
            Text { text: "Open a conversation and expand Goose options above its Send button to select the provider, model, mode, and thinking effort offered by Goose for that session."; color: Theme.text; wrap: word-wrap; }
            Text { text: "Cheap model for search summaries"; color: Theme.text; font-size: Theme.font-size-large; font-weight: 600; }
            Text { text: "Search runs locally. Background summaries use this profile and the selected provider's saved Goose credentials. If unavailable, search uses existing titles and summaries without a more expensive model fallback."; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: "Profile name"; color: Theme.text-muted; width: 110px; vertical-alignment: center; }
                LineEdit { text <=> GooseState.cheap-name; enabled: !GooseState.cheap-loading; }
            }
            HorizontalLayout {
                Text { text: "Provider"; color: Theme.text-muted; width: 110px; vertical-alignment: center; }
                ComboBox { model: ["Bedrock", "OpenAI", "Anthropic"]; current-index <=> GooseState.cheap-provider; enabled: !GooseState.cheap-loading; }
            }
            HorizontalLayout {
                Text { text: "Model ID"; color: Theme.text-muted; width: 110px; vertical-alignment: center; }
                LineEdit { text <=> GooseState.cheap-model; enabled: !GooseState.cheap-loading; }
            }
            FlatButton { text: "Save cheap profile"; enabled: !GooseState.cheap-loading; clicked => { GooseState.save-cheap(); } }
            if GooseState.cheap-status != "": Text { text: GooseState.cheap-status; color: Theme.text-muted; wrap: word-wrap; }
        }
    }
}
