// Native port of T3 Code's sidebar chrome/search layout. See NOTICE.
// Conversation search is local; Rally is a permanent independent area.
//
// Rust (src/sidebar.rs) flattens folders and threads into `SidebarState.rows`
// and keeps the open-tab status dots up to date.

import { CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme, FlatButton, LinkButton } from "theme.slint";

// Mirrored by `RowSpec` in src/sidebar.rs.
export enum SidebarRowKind { folder, thread, more, section }

// Status of a thread that is open in a tab (`not-open` otherwise).
export enum SidebarThreadStatus { not-open, unread, idle, starting, running, waiting, error }

export struct SidebarRow {
    project: string,
    section: string,
    pinned: bool,
    auto-settle-enabled: bool,
    regenerating-title: bool,
    checked: bool,
    kind: SidebarRowKind,
    // Thread id (thread rows) or folder path (folder rows).
    id: string,
    title: string,
    tooltip: string,
    generated-title: bool,
    // Folder rows: full path. Thread rows: relative update time.
    detail: string,
    // Folder of the thread, or the folder itself.
    folder: string,
    // Folder rows: number of loaded threads.
    count: int,
    collapsed: bool,
    status: SidebarThreadStatus,
    selected: bool,
}

export global SidebarState {
    in property <int> regenerating-titles;
    in property <string> title-generation-status;
    in-out property <bool> group-projects;
    in-out property <bool> working-section;
    in-out property <int> auto-settle-days;
    callback policy-changed(string, int);
    in property <bool> dragging;
    in property <string> drop-target;
    in-out property <float> drop-zone-top;
    in-out property <float> list-top;
    in-out property <float> drag-x;
    in-out property <float> drag-y;
    callback drag-begin(string);
    callback drag-move(float, float);
    callback drag-end(float, float, bool);
    in property <[string]> project-choices;
    in property <int> project-index;
    in property <bool> organization-ready;
    in property <string> organization-error;
    in property <bool> selecting;
    in property <int> selection-count;
    callback project-selected(int);
    callback organization-action(string);
    callback section-toggle(string);
    in property <bool> rally-selected;
    in property <int> rally-count;
    callback open-rally();
    callback open-palette();
    callback new-thread();
    callback add-project();
    callback open-settings();
    in property <[SidebarRow]> rows;
    // First page of a (re)load in flight.
    in property <bool> loading;
    in property <bool> searching-history;
    in property <bool> loading-more;
    in property <bool> has-more;
    in property <string> error;
    in property <string> empty-text: "No threads yet";
    in property <bool> archived;
    in-out property <string> search-text;
    // Set by Rust to move keyboard focus into the search box.
    in-out property <bool> focus-search-requested;

    in-out property <float> title-available-width: 150;
    in-out property <float> title-character-width: 7;
    in-out property <string> tooltip-key;
    in-out property <string> tooltip-text;
    in-out property <length> tooltip-anchor-y;
    callback fit-title(text: string, available: float, measured: float) -> string;
    in-out property <float> viewport-offset;
    in-out property <float> viewport-height;
    callback width-changed(float);
    callback budget-changed();
    callback viewport-changed();
    callback search-edited(text: string);
    callback toggle-archived();
    callback refresh();
    callback load-more();
    callback open-thread(id: string, folder: string);
    callback thread-action(id: string, action: string);
    callback folder-action(path: string, action: string);
}

// Tooltip content never opens a native cursor-positioned window. The owning
// app places the one shared overlay entirely inside its conversation pane.
component SidebarHint inherits Rectangle {
    in property <bool> hovered;
    in property <string> hint-key;
    in property <string> text;
    in property <length> anchor-y;
    width: 0px; height: 0px;
    changed hovered => {
        delay.running = false;
        if hovered {
            SidebarState.tooltip-key = hint-key;
            SidebarState.tooltip-text = "";
            delay.running = true;
        } else if SidebarState.tooltip-key == hint-key {
            SidebarState.tooltip-text = "";
            SidebarState.tooltip-key = "";
        }
    }
    delay := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if hovered && SidebarState.tooltip-key == hint-key {
                SidebarState.tooltip-anchor-y = anchor-y;
                SidebarState.tooltip-text = text;
            }
        }
    }
}

export component SidebarTooltip inherits Rectangle {
    in property <length> pane-x;
    in property <length> pane-y;
    in property <length> pane-width;
    in property <length> pane-height;
    visible: SidebarState.tooltip-text != "" && pane-width > 32px && pane-height > 32px;
    x: pane-x + 8px;
    width: min(420px, max(0px, pane-width - 16px));
    height: min(max(0px, pane-height - 16px), tip.preferred-height + 24px);
    y: clamp(SidebarState.tooltip-anchor-y, pane-y + 8px, pane-y + pane-height - self.height - 8px);
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-small;
    clip: true;
    ScrollView {
        x: 10px; y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        content-width: self.visible-width;
        content-height: tip.preferred-height;
        tip := Text {
            width: parent.visible-width;
            text: SidebarState.tooltip-text;
            color: Theme.text;
            font-size: Theme.font-size;
            wrap: word-wrap;
        }
    }
}

component StatusDot inherits Rectangle {
    in property <SidebarThreadStatus> status;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: status == SidebarThreadStatus.running || status == SidebarThreadStatus.unread ? Theme.accent
        : status == SidebarThreadStatus.waiting ? Theme.warning
        : status == SidebarThreadStatus.error ? Theme.danger
        : status == SidebarThreadStatus.starting ? Theme.text-faint
        : transparent;
    border-width: status == SidebarThreadStatus.idle ? 1px : 0px;
    border-color: Theme.text-muted;
}

component FolderRowView inherits Rectangle {
    in property <SidebarRow> item;

    height: 30px;

    folder-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "New thread in this folder";
                activated => { SidebarState.folder-action(item.folder, "new-thread"); }
            }
            MenuItem {
                title: "Open folder";
                activated => { SidebarState.folder-action(item.folder, "open-folder"); }
            }
            MenuItem {
                title: "Copy path";
                activated => { SidebarState.folder-action(item.folder, "copy-path"); }
            }
            MenuItem {
                title: "Project display name…";
                activated => { SidebarState.folder-action(item.folder, "rename-project"); }
            }
            MenuSeparator { }
            MenuItem {
                title: item.collapsed ? "Expand" : "Collapse";
                activated => { SidebarState.folder-action(item.folder, "toggle"); }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { SidebarState.folder-action(item.folder, "toggle"); }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    folder-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }

    Rectangle {
        x: Theme.pad-s;
        width: parent.width - 2 * Theme.pad-s;
        border-radius: Theme.radius-small;
        background: touch.has-hover ? Theme.hover : transparent;

        HorizontalLayout {
            padding-left: Theme.pad-s;
            padding-right: Theme.pad-m;
            spacing: Theme.pad-s;

            Text {
                text: item.collapsed ? "▸" : "▾";
                width: 12px;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
            Text {
                text: item.title;
                color: Theme.text;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: item.count;
                color: Theme.text-faint;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
            }
            FlatButton {
                text: "+";
                width: 24px;
                clicked => { SidebarState.folder-action(item.folder, "new-thread"); }

            }
        }
    }

    SidebarHint {
        hovered: touch.has-hover;
        hint-key: "folder:" + item.id;
        text: item.detail + " — Click to expand or collapse. + starts a conversation.";
        anchor-y: root.absolute-position.y;
    }
}

component ThreadRowView inherits Rectangle {
    property <bool> drag-started;
    property <bool> drag-released;
    in property <SidebarRow> item;

    height: 28px;
    property <string> status-hint: item.status == SidebarThreadStatus.running ? "Working"
        : item.status == SidebarThreadStatus.waiting ? "Waiting for your input"
        : item.status == SidebarThreadStatus.error ? "Needs attention: the last operation failed"
        : item.status == SidebarThreadStatus.unread ? "Unread activity"
        : item.status == SidebarThreadStatus.idle ? "Read · Idle"
        : "Not yet viewed";
    property <string> fitted-title: item.title;
    property <length> measured-width: title-measure.preferred-width;
    changed item => { fitted-title = item.title; }
    changed width => { fitted-title = item.title; }
    property <length> available-width: title-label.width;
    changed available-width => { root.fit-title(); }
    changed measured-width => { root.fit-title(); }
    function fit-title() {
        if item.generated-title && measured-width > title-label.width && title-label.width > 0px {
            fitted-title = SidebarState.fit-title(fitted-title, title-label.width / 1px, measured-width / 1px);
        }
    }
    title-measure := Text { visible: false; text: root.fitted-title; font-size: Theme.font-size; }


    thread-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Open";
                activated => { SidebarState.thread-action(item.id, "open"); }
            }
            MenuItem {
                title: "New thread in this folder";
                activated => { SidebarState.thread-action(item.id, "new-thread"); }
            }
            MenuSeparator { }
            MenuItem {
                title: item.pinned ? "Unpin" : "Pin";
                enabled: SidebarState.organization-ready && !SidebarState.archived;
                activated => { SidebarState.thread-action(item.id, item.pinned ? "unpin" : "pin"); }
            }
            MenuItem {
                title: item.section == "settled" ? "Unsettle" : "Settle";
                enabled: SidebarState.organization-ready && !SidebarState.archived;
                activated => { SidebarState.thread-action(item.id, item.section == "settled" ? "unsettle" : "settle"); }
            }
            Menu {
                title: "Snooze";
                MenuItem { title: "For one hour"; enabled: SidebarState.organization-ready; activated => { SidebarState.thread-action(item.id, "snooze-hour"); } }
                MenuItem { title: "For one day"; enabled: SidebarState.organization-ready; activated => { SidebarState.thread-action(item.id, "snooze-day"); } }
                MenuItem { title: "Until…"; enabled: SidebarState.organization-ready; activated => { SidebarState.thread-action(item.id, "snooze-custom"); } }
                MenuItem { title: "Wake now"; enabled: SidebarState.organization-ready; activated => { SidebarState.thread-action(item.id, "wake"); } }
            }
            MenuItem { title: "Move up"; enabled: SidebarState.organization-ready && (item.section == "pinned" || item.section == "active"); activated => { SidebarState.thread-action(item.id, "move-up"); } }
            MenuItem { title: "Move down"; enabled: SidebarState.organization-ready && (item.section == "pinned" || item.section == "active"); activated => { SidebarState.thread-action(item.id, "move-down"); } }
            MenuItem { title: "Mark unread"; activated => { SidebarState.thread-action(item.id, "mark-unread"); } }
            MenuItem {
                title: item.auto-settle-enabled ? "Disable auto-settle" : "Enable auto-settle";
                enabled: SidebarState.organization-ready && !SidebarState.archived;
                activated => { SidebarState.thread-action(item.id, item.auto-settle-enabled ? "auto-settle-off" : "auto-settle-on"); }
            }
            MenuItem { title: "Select"; activated => { SidebarState.thread-action(item.id, "select"); } }
            MenuSeparator { }
            MenuItem {
                title: "Rename…";
                activated => { SidebarState.thread-action(item.id, "rename"); }
            }
            MenuItem {
                title: item.regenerating-title ? "Regenerating title…" : "Regenerate title";
                enabled: !item.regenerating-title && SidebarState.regenerating-titles == 0
                    && item.status != SidebarThreadStatus.running && item.status != SidebarThreadStatus.starting;
                activated => { SidebarState.thread-action(item.id, "regenerate-title"); }
            }
            MenuItem {
                title: SidebarState.archived ? "Unarchive" : "Archive";
                activated => { SidebarState.thread-action(item.id, SidebarState.archived ? "unarchive" : "archive"); }
            }
            MenuItem {
                title: "Delete…";
                activated => { SidebarState.thread-action(item.id, "delete"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Copy thread id";
                activated => { SidebarState.thread-action(item.id, "copy-id"); }
            }
        }

        touch := TouchArea {
            mouse-cursor: root.drag-started && SidebarState.dragging ? grabbing : pointer;
            clicked => {
                if root.drag-released { root.drag-released = false; }
                else if SidebarState.selecting { SidebarState.thread-action(item.id, "select"); }
                else { SidebarState.open-thread(item.id, item.folder); }
            }
            moved => {
                if self.pressed && !root.drag-started && !root.drag-released
                    && abs(self.mouse-y - self.pressed-y) + abs(self.mouse-x - self.pressed-x) > 6px {
                    SidebarState.drag-begin(item.id);
                    root.drag-started = SidebarState.dragging;
                }
                if root.drag-started {
                    SidebarState.drag-x = (self.absolute-position.x + self.mouse-x) / 1px;
                    SidebarState.drag-y = (self.absolute-position.y + self.mouse-y) / 1px;
                    SidebarState.drag-move(SidebarState.drag-x, SidebarState.drag-y);
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-released = false;
                    root.drag-started = false;
                }
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    thread-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
                if root.drag-started && (event.kind == PointerEventKind.cancel
                    || (event.button == PointerEventButton.left && event.kind == PointerEventKind.up)) {
                    root.drag-started = false;
                    root.drag-released = true;
                    SidebarState.drag-end((self.absolute-position.x + self.mouse-x) / 1px,
                        (self.absolute-position.y + self.mouse-y) / 1px,
                        event.kind == PointerEventKind.up && SidebarState.dragging);
                }
            }
        }
    }

    Rectangle {
        x: Theme.pad-s;
        width: parent.width - 2 * Theme.pad-s;
        border-radius: Theme.radius-small;
        background: item.selected || item.checked ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

        HorizontalLayout {
            padding-left: SidebarState.selecting ? 8px : 22px;
            padding-right: Theme.pad-m;
            spacing: Theme.pad-m;

            if SidebarState.selecting: CheckBox {
                checked: item.checked;
                toggled => { SidebarState.thread-action(item.id, "select"); }
            }
            StatusDot {
                status: item.status;
                y: (parent.height - self.height) / 2;
            }
            title-label := Text {
                text: item.generated-title ? root.fitted-title : item.title;
                font-size: Theme.font-size;
                color: item.selected ? Theme.text : Theme.text-muted;
                overflow: item.generated-title ? clip : elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: item.detail;
                width: 52px;
                color: Theme.text-faint;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
            }
        }
    }

    SidebarHint {
        hovered: touch.has-hover && !SidebarState.dragging;
        hint-key: "thread:" + item.id;
        text: root.status-hint + (item.tooltip == "" ? "" : "\n\n" + item.tooltip);
        anchor-y: root.absolute-position.y;
    }
    Rectangle { x: 12px; width: parent.width - 24px; height: 2px;
        visible: SidebarState.dragging && SidebarState.drop-target == item.id; background: Theme.accent; }
}

component MoreRowView inherits Rectangle {
    height: 32px;

    touch := TouchArea {
        enabled: !SidebarState.loading-more;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { SidebarState.load-more(); }
    }

    Text {
        text: SidebarState.loading-more ? "Loading…" : "Load more threads";
        color: touch.has-hover ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-size-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SectionRowView inherits Rectangle {
    in property <SidebarRow> item;
    height: 32px;
    background: SidebarState.dragging && SidebarState.drop-target == item.id ? Theme.selected : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 6px;
        Text { text: item.collapsed ? "▸" : "▾"; color: Theme.text-faint; width: 12px; vertical-alignment: center; }
        Text { text: item.title; font-size: Theme.font-size-small; color: Theme.text-muted; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: item.count; font-size: Theme.font-size-small; color: Theme.text-faint; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { SidebarState.section-toggle(item.id); } }
    accessible-role: button;
    accessible-label: item.title + " conversations";
    accessible-action-default => { SidebarState.section-toggle(item.id); }
}

export component Sidebar inherits Rectangle {
    background: Theme.sidebar-bg;
    property <float> drop-top: drop-bar.absolute-position.y / 1px;
    property <float> rows-top: list.absolute-position.y / 1px;
    changed drop-top => { SidebarState.drop-zone-top = drop-top; }
    changed rows-top => { SidebarState.list-top = rows-top; }
    Timer {
        interval: 40ms;
        running: SidebarState.dragging && SidebarState.drag-x >= 0 && SidebarState.drag-x < root.width / 1px
            && SidebarState.drag-y >= root.rows-top && SidebarState.drag-y <= root.rows-top + SidebarState.viewport-height
            && (SidebarState.drag-y < root.rows-top + 28 || SidebarState.drag-y > root.rows-top + SidebarState.viewport-height - 28);
        triggered => {
            list.content-y = clamp(list.content-y + (SidebarState.drag-y < root.rows-top + 28 ? 14px : -14px),
                min(0px, list.visible-height - list.content-height), 0px);
            SidebarState.drag-move(SidebarState.drag-x, SidebarState.drag-y);
        }
    }
    // Representative prose estimates capacity; each final title is also measured.
    probe := Text { visible: false; text: "Updating project dependencies and fixing tests"; font-size: Theme.font-size; }
    property <length> glyph-width: probe.preferred-width / 46;
    changed width => { SidebarState.title-available-width = max(1px, self.width - 112px) / 1px; SidebarState.budget-changed(); }
    changed glyph-width => { SidebarState.title-character-width = glyph-width / 1px; SidebarState.budget-changed(); }

    property <bool> want-search-focus: SidebarState.focus-search-requested;
    changed want-search-focus => {
        if want-search-focus {
            search.focus();
            SidebarState.focus-search-requested = false;
        }
    }
    init => {
        SidebarState.drop-zone-top = drop-top;
        SidebarState.list-top = rows-top;
        SidebarState.title-available-width = max(1px, self.width - 112px) / 1px;
        SidebarState.title-character-width = glyph-width / 1px;
        if SidebarState.focus-search-requested {
            search.focus();
            SidebarState.focus-search-requested = false;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: Theme.pad-m;
            padding-right: Theme.pad-m;
            padding-top: Theme.pad-xs;
            padding-bottom: Theme.pad-m;
            spacing: 4px;
            height: 40px;

            LinkButton { text: "⌘"; width: 28px; accessible-label: "Command palette"; clicked => { SidebarState.open-palette(); } }
            search := LineEdit {
                text <=> SidebarState.search-text;
                placeholder-text: "Search";
                edited(text) => { SidebarState.search-edited(text); }
            }
            LinkButton {
                text: "+";
                width: 28px;
                text-color: Theme.text-muted;
                accessible-label: "New thread";
                clicked => { SidebarState.new-thread(); }
            }
        }

        Rectangle {
            height: 36px;
            rally-row := Rectangle {
                x: 8px; y: 2px;
                width: parent.width - 16px; height: 32px;
                border-radius: 6px;
                background: SidebarState.rally-selected ? Theme.selected : rally-touch.has-hover ? Theme.hover : transparent;
                Path {
                    x: 8px; y: 9px; width: 16px; height: 14px;
                    viewbox-width: 16; viewbox-height: 14;
                    commands: "M1 1 H15 V13 H1 Z M6 1 V13 M11 1 V13";
                    stroke: Theme.text-muted; stroke-width: 1px;
                }
                Text {
                    x: 32px; width: parent.width - 70px; height: parent.height;
                    text: "Rally"; color: Theme.text; font-size: Theme.font-size;
                    vertical-alignment: center;
                }
                Text {
                    x: parent.width - 34px; width: 26px; height: parent.height;
                    text: SidebarState.rally-count > 0 ? SidebarState.rally-count : "";
                    color: Theme.text-faint; font-size: Theme.font-size-small;
                    vertical-alignment: center; horizontal-alignment: right;
                }
                rally-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { SidebarState.open-rally(); }
                }
                accessible-role: button;
                accessible-label: "Rally project";
                accessible-action-default => { SidebarState.open-rally(); }
            }
        }

        HorizontalLayout {
            height: 30px;
            padding-left: 12px;
            padding-right: 10px;
            ComboBox {
                model: SidebarState.project-choices;
                current-index: SidebarState.project-index;
                selected => { SidebarState.project-selected(self.current-index); }
            }
            LinkButton {
                text: "+"; width: 26px; accessible-label: "Add repository project";
                clicked => { SidebarState.add-project(); }
            }
            LinkButton {
                text: SidebarState.selecting ? "Done" : "Select";
                clicked => { SidebarState.organization-action("select"); }
            }
        }

        if SidebarState.selecting: VerticalLayout {
            spacing: 4px; padding: 8px;
            HorizontalLayout {
                Text { text: SidebarState.selection-count + " selected"; color: Theme.text-muted; vertical-alignment: center; }
                LinkButton { text: "All"; clicked => { SidebarState.organization-action("select-all"); } }
                LinkButton { text: "Clear"; clicked => { SidebarState.organization-action("clear"); } }
            }
            HorizontalLayout {
                FlatButton { text: "Pin"; enabled: SidebarState.selection-count > 0 && SidebarState.organization-ready; clicked => { SidebarState.organization-action("pin"); } }
                FlatButton { text: "Settle"; enabled: SidebarState.selection-count > 0 && SidebarState.organization-ready; clicked => { SidebarState.organization-action("settle"); } }
                FlatButton { text: "Snooze…"; enabled: SidebarState.selection-count > 0 && SidebarState.organization-ready; clicked => { SidebarState.organization-action("snooze-custom"); } }
            }
            HorizontalLayout {
                LinkButton { text: "Wake"; enabled: SidebarState.selection-count > 0 && SidebarState.organization-ready; clicked => { SidebarState.organization-action("wake"); } }
                LinkButton { text: "Unpin"; enabled: SidebarState.selection-count > 0 && SidebarState.organization-ready; clicked => { SidebarState.organization-action("unpin"); } }
                LinkButton { text: "Unread"; enabled: SidebarState.selection-count > 0; clicked => { SidebarState.organization-action("mark-unread"); } }
                LinkButton { text: "Delete"; enabled: SidebarState.selection-count > 0; clicked => { SidebarState.organization-action("delete"); } }
                LinkButton { text: "Retitle"; enabled: SidebarState.selection-count > 0 && SidebarState.regenerating-titles == 0; clicked => { SidebarState.organization-action("regenerate-title"); } }
            }
        }
        if SidebarState.title-generation-status != "": VerticalLayout {
            padding: 8px; spacing: 4px;
            Text { text: SidebarState.title-generation-status; color: Theme.text-muted; font-size: Theme.font-size-small; wrap: word-wrap; }
            LinkButton {
                text: SidebarState.regenerating-titles > 0 ? "Cancel remaining" : "Dismiss";
                clicked => { SidebarState.organization-action(SidebarState.regenerating-titles > 0 ? "cancel-titles" : "clear-title-status"); }
            }
        }
        if SidebarState.organization-error != "": VerticalLayout {
            padding: 8px;
            Text { text: SidebarState.organization-error; color: Theme.danger; wrap: word-wrap; }
            LinkButton { text: "Retry organization"; clicked => { SidebarState.organization-action("retry"); } }
        }

        if SidebarState.searching-history: Text {
            text: "Searching conversation history…";
            color: Theme.text-faint;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
        if SidebarState.error != "" && SidebarState.rows.length > 0: Text {
            text: SidebarState.error;
            color: Theme.danger;
            wrap: word-wrap;
        }
        drop-bar := Rectangle {
            height: SidebarState.dragging ? 30px : 0px;
            visible: SidebarState.dragging;
            clip: true;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                for target in [{ id: "pinned", label: "Pin" }, { id: "active", label: "Active" }, { id: "settled", label: "Settle" }]: Rectangle {
                    background: SidebarState.drop-target == target.id ? Theme.selected : Theme.surface;
                    border-color: SidebarState.drop-target == target.id ? Theme.accent : Theme.border;
                    border-width: 1px;
                    Text { text: target.label; color: Theme.text; font-size: Theme.font-size-small;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;

            list := ListView {
                for row in SidebarState.rows: Rectangle {
                    height: row.kind == SidebarRowKind.folder ? 30px
                        : row.kind == SidebarRowKind.thread ? 28px
                        : 32px;
                    if row.kind == SidebarRowKind.section: SectionRowView { item: row; }
                    if row.kind == SidebarRowKind.folder: FolderRowView {
                        item: row;
                    }
                    if row.kind == SidebarRowKind.thread: ThreadRowView {
                        item: row;
                    }
                    if row.kind == SidebarRowKind.more: MoreRowView { }
                }

                changed visible-height => {
                    SidebarState.viewport-height = self.visible-height / 1px;
                    SidebarState.viewport-changed();
                }
                changed content-y => {
                    SidebarState.tooltip-text = "";
                    SidebarState.viewport-offset = -self.content-y / 1px;
                    SidebarState.viewport-height = self.visible-height / 1px;
                    SidebarState.viewport-changed();
                    if SidebarState.has-more && !SidebarState.loading-more
                        && -self.content-y + self.visible-height >= self.content-height - 120px {
                        SidebarState.load-more();
                    }
                }
            }

            if SidebarState.rows.length == 0: VerticalLayout {
                alignment: center;
                padding: Theme.pad-xl;
                spacing: Theme.pad-m;

                Text {
                    text: SidebarState.loading ? "Loading threads…"
                        : SidebarState.error != "" ? SidebarState.error
                        : SidebarState.empty-text;
                    color: SidebarState.error != "" && !SidebarState.loading ? Theme.danger : Theme.text-faint;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                if SidebarState.error != "" && !SidebarState.loading: HorizontalLayout {
                    alignment: center;
                    LinkButton {
                        text: "Retry";
                        clicked => { SidebarState.refresh(); }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 40px;
            padding-left: 12px; padding-right: 12px;
            spacing: 8px;
            LinkButton {
                text: "Settings";
                text-color: Theme.text-muted;
                clicked => { SidebarState.open-settings(); }
            }
            LinkButton {
                text: "↻"; width: 26px; text-color: Theme.text-muted;
                enabled: !SidebarState.loading;
                clicked => { SidebarState.refresh(); }
            }
            Rectangle { horizontal-stretch: 1; }
            LinkButton {
                text: SidebarState.archived ? "Show active" : "Archived";
                text-color: Theme.text-muted;
                clicked => { SidebarState.toggle-archived(); }
            }
        }
    }
}
